@@ -2310,18 +2329,39 @@ def _mosaic_spans(weights, gap, total=1.0):
     -------
     tuple of numpy.ndarray
         ``(starts, widths)``. Segment ``i`` spans ``[starts[i],
-        starts[i] + widths[i]]``; consecutive segments are separated by
-        exactly ``gap``, and the whole row spans exactly ``[0, total]``.
-        A segment with weight 0 gets width 0 (invisible), but still
-        occupies its slot -- and its gap -- in the layout.
+        starts[i] + widths[i]]``; consecutive *nonzero-weight* segments
+        are separated by exactly ``gap``, and the drawn (nonzero-weight)
+        segments together span exactly ``[0, total]`` -- the last one
+        always ends at ``total``, regardless of how many zero-weight
+        segments follow it. A segment with weight 0 gets width 0
+        (invisible) and consumes no space of its own: it is placed at
+        whichever position it would otherwise have started at, with no
+        gap reserved before or after it, so it never leaves a visible
+        empty sliver where a real segment should be.
     """
     weights = np.asarray(weights, dtype=float)
     n = len(weights)
-    total_gap = gap * max(n - 1, 0)
+    nonzero = weights > 0
+    n_nonzero = int(nonzero.sum())
+    # The gap budget is sized to the segments that actually draw
+    # something, not to every slot -- a zero-weight segment is invisible
+    # either way, but reserving it a trailing gap (as if it were about to
+    # draw something) left a visible sliver of empty space between the
+    # last real segment and the far edge whenever a zero-weight segment
+    # happened to be the last one in the row (e.g. a y-category that
+    # never occurred with this particular x-value). That's what made a
+    # mosaic column's segments sometimes fall short of the top instead of
+    # always summing to `total`.
+    total_gap = gap * max(n_nonzero - 1, 0)
     available = max(total - total_gap, 0.0)
     total_weight = weights.sum()
     widths = weights / total_weight * available if total_weight > 0 else weights
-    starts = np.concatenate([[0.0], np.cumsum(widths + gap)[:-1]])
+    starts = np.zeros(n)
+    pos = 0.0
+    for i in range(n):
+        starts[i] = pos
+        if weights[i] > 0:
+            pos += widths[i] + gap
     return starts, widths
 
 
