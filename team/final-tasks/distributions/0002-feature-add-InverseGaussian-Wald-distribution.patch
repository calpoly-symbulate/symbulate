diff --git a/symbulate/tests/test_distributions.py b/symbulate/tests/test_distributions.py
index 911ebcf..b5ae16e 100644
--- a/symbulate/tests/test_distributions.py
+++ b/symbulate/tests/test_distributions.py
@@ -2409,6 +2409,78 @@ class TestLogGamma(unittest.TestCase):
         plt.close("all")
 
 
+class TestInverseGaussian(unittest.TestCase):
+
+    def test_InverseGaussian_distributional(self):
+        distributions.rng = np.random.default_rng(42)
+        mean, shape = 2.0, 3.0
+        X = RV(InverseGaussian(mean=mean, shape=shape))
+        sims = X.sim(Nsim)
+        cdf = stats.invgauss(mu=mean / shape, scale=shape).cdf
+        pval = stats.kstest(sims, cdf).pvalue
+        self.assertTrue(pval > 0.01)
+
+    def test_InverseGaussian_mean_matches_parameter(self):
+        for mean, shape in [(1, 1), (2, 3), (5, 0.5)]:
+            X = InverseGaussian(mean=mean, shape=shape)
+            self.assertAlmostEqual(float(X.mean()), mean, places=8)
+
+    def test_InverseGaussian_variance_is_mean_cubed_over_shape(self):
+        for mean, shape in [(1, 1), (2, 3), (5, 0.5)]:
+            X = InverseGaussian(mean=mean, shape=shape)
+            self.assertAlmostEqual(float(X.var()), mean**3 / shape, places=8)
+
+    def test_InverseGaussian_pdf_matches_scipy(self):
+        mean, shape = 2.0, 3.0
+        X = InverseGaussian(mean=mean, shape=shape)
+        th = stats.invgauss(mu=mean / shape, scale=shape)
+        for x in [0.5, 1.0, 2.0, 5.0]:
+            self.assertAlmostEqual(float(X.pdf(x)), float(th.pdf(x)), places=10)
+
+    def test_InverseGaussian_default_parameters(self):
+        X = InverseGaussian()
+        self.assertEqual(X.mean_param, 1.0)
+        self.assertEqual(X.shape, 1.0)
+        self.assertAlmostEqual(float(X.mean()), 1.0, places=8)
+
+    def test_InverseGaussian_support_is_positive(self):
+        X = InverseGaussian(mean=2, shape=3)
+        low, high = X._support()
+        self.assertEqual(low, 0.0)
+        self.assertTrue(float(X.pdf(-1)) == 0.0 or math.isnan(float(X.pdf(-1))))
+
+    def test_InverseGaussian_approaches_normal_as_shape_grows(self):
+        # As shape -> infinity with mean fixed, variance = mean**3 / shape
+        # shrinks toward 0 around the same mean.
+        mean = 4.0
+        shapes = [1, 10, 1_000, 1_000_000]
+        variances = [InverseGaussian(mean=mean, shape=s).var() for s in shapes]
+        self.assertEqual(list(variances), sorted(variances, reverse=True))
+        self.assertAlmostEqual(float(variances[-1]), 0.0, places=3)
+
+    def test_InverseGaussian_draw_is_scalar_in_support(self):
+        distributions.rng = np.random.default_rng(0)
+        value = InverseGaussian(mean=2, shape=3).draw()
+        self.assertIsInstance(value, Scalar)
+        self.assertGreater(float(value), 0.0)
+
+    def test_InverseGaussian_invalid_mean_raises(self):
+        for bad in [-1, 0, "a"]:
+            self.assertRaises(Exception, lambda b=bad: InverseGaussian(mean=b))
+
+    def test_InverseGaussian_invalid_shape_raises(self):
+        for bad in [-1, 0, "a"]:
+            self.assertRaises(Exception, lambda b=bad: InverseGaussian(shape=b))
+
+    def test_InverseGaussian_plots_without_error(self):
+        # draw / RV / sim / plot all wired through the base class.
+        InverseGaussian(mean=2, shape=3).draw()
+        RV(InverseGaussian(mean=2, shape=3)).sim(100).plot()
+        InverseGaussian(mean=2, shape=3).plot()
+        InverseGaussian(mean=2, shape=3).plot(cdf=True)
+        plt.close("all")
+
+
