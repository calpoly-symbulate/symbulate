+            ContinuousTimeFunction(lambda t: t).plot(tmin=0, tmax=5, type="hist")
+        self.assertIn("ContinuousTimeFunction.plot()", str(cm.exception))
+
+    def test_none_is_still_accepted_everywhere(self):
