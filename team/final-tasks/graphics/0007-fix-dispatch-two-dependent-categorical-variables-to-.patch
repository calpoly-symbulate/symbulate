diff --git a/symbulate/tests/test_plot.py b/symbulate/tests/test_plot.py
index d4121bb..fd14108 100644
--- a/symbulate/tests/test_plot.py
+++ b/symbulate/tests/test_plot.py
@@ -1342,6 +1342,71 @@ class TestPlotCategorical(PlotTestCase):
         self.assertEqual(labels, ["a", "b", "c"])
 
 
+class TestPlot2DCategorical(PlotTestCase):
+    """2D categorical (string, string) outcomes, routed through .plot().
+
+    Before this dispatch existed, a pair of dependent categorical
+    variables built from a raw ProbabilitySpace -- not a numeric vector,
+    so RVResults.dim is None -- fell all the way through to the
+    ensemble path-plot branch and drew each pair as a meaningless
+    two-point line against index (0, 1) instead of a real 2D plot.
+    """
+
+    def setUp(self):
+        np.random.seed(42)
+
+        def event_sim():
+            a = BoxModel(["a", "not a"], probs=[0.8, 0.2]).draw()
+            if a == "a":
+                b = BoxModel(["b", "not b"], probs=[0.7, 0.3]).draw()
+            else:
+                b = BoxModel(["b", "not b"], probs=[0.6, 0.4]).draw()
+            return a, b
+
+        self.X, self.Y = RV(ProbabilitySpace(event_sim))
+
+    def test_default_is_a_real_2d_plot_not_a_sample_path(self):
+        (self.X & self.Y).sim(1000).plot(suggest=False)
+        ax = plt.gca()
+        self.assertNotEqual(ax.get_title(), "Sample Path")
+        self.assertEqual(ax.get_title(), "Tile Plot")
+
+    def test_explicit_mosaic_type(self):
+        (self.X & self.Y).sim(1000).plot(type="mosaic", suggest=False)
+        self.assertEqual(plt.gca().get_title(), "Mosaic Plot")
+
+    def test_explicit_stackedbar_type(self):
+        (self.X & self.Y).sim(1000).plot(type="stackedbar", suggest=False)
+        self.assertEqual(plt.gca().get_title(), "Stacked Bar Chart")
+
+    def test_tile_labels_use_category_names(self):
+        (self.X & self.Y).sim(1000).plot(type="tile", suggest=False)
+        ax = plt.gca()
+        xlabels = [t.get_text() for t in ax.get_xticklabels()]
+        self.assertIn("a", xlabels)
+        self.assertIn("not a", xlabels)
+
+    def test_small_n_still_uses_tile_default(self):
+        """No categorical scatter is offered, so small samples still get
+        tile rather than an unsupported scatter default."""
+        (self.X & self.Y).sim(10).plot(suggest=False)
+        self.assertEqual(plt.gca().get_title(), "Tile Plot")
+
+    def test_unsupported_type_raises_helpful_error(self):
+        with self.assertRaises(ValueError) as cm:
+            (self.X & self.Y).sim(100).plot(type="scatter", suggest=False)
+        message = str(cm.exception)
+        self.assertIn("categorical", message)
+        self.assertIn("tile", message)
+        self.assertIn("mosaic", message)
+        self.assertIn("stackedbar", message)
+
+    def test_marginal_not_yet_supported_raises_helpful_error(self):
+        with self.assertRaises(ValueError) as cm:
+            (self.X & self.Y).sim(100).plot(marginal=True, suggest=False)
+        self.assertIn("marginal=True", str(cm.exception))
+
