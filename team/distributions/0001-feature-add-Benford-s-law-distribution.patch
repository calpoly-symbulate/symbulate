From de597389012cbe58d9065aaf5d89ee37a19ae760 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 9 Aug 2026 02:57:43 +0000
Subject: [PATCH 1/4] feature: add Benford's law distribution

Adds Benford(base=10), a discrete distribution over leading digits
1..base-1 with pmf log_base(1 + 1/d). Not available in scipy, so it is
implemented via a small custom rv_discrete generator (_benford_gen),
following the same pattern _makeham_gen uses for Makeham. Exported from
symbulate/__init__.py; tests added to test_distributions.py covering
the pmf formula, normalization, the classic ~30% leading-1 fact,
non-default bases, error handling, and plotting.
---
 symbulate/__init__.py                 |  1 +
 symbulate/distributions.py            | 93 +++++++++++++++++++++++++++
 symbulate/tests/test_distributions.py | 77 ++++++++++++++++++++++
 3 files changed, 171 insertions(+)

diff --git a/symbulate/__init__.py b/symbulate/__init__.py
index b7a366e..999d921 100644
--- a/symbulate/__init__.py
+++ b/symbulate/__init__.py
@@ -31,6 +31,7 @@ from .distributions import (
     DiscreteUniform,
